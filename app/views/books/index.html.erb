<% content_for :title, "Home | Book Collection" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">Your library</p>
    <h1>Book Collection</h1>
  </div>
  <%= link_to "Add a Book", new_book_path, class: "button button-primary" %>
</div>

<div id="books">
  <% @books.each do |book| %>
    <section class="book-row">
      <%= render book %>
      <div class="book-actions">
        <%= link_to "Show", book_path(book), class: "button button-secondary" %>
        <%= link_to "Update", edit_book_path(book), class: "button button-secondary" %>
        <%= link_to "Delete", delete_book_path(book), class: "button button-danger" %>
      </div>
    </section>
  <% end %>

  <% if @books.empty? %>
    <p class="empty-state">No books yet. Add your first book to start your collection.</p>
  <% end %>
</div>
