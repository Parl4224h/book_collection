<% content_for :title, "User Details | Book Collection" %>
<h1>User Details</h1>
<p><strong>Username:</strong> <%= @user.username %></p>

<h2>Books</h2>
<% if @user.books.any? %>
  <ul>
    <% @user.books.order(:title).each do |book| %>
      <li><%= link_to book.title, book %></li>
    <% end %>
  </ul>
<% else %>
  <p>This user has no assigned books.</p>
<% end %>

<div class="form-actions">
  <%= link_to "Update this user", edit_user_path(@user), class: "button button-primary" %>
  <%= link_to "Back to Users", users_path, class: "button button-secondary" %>
</div>
