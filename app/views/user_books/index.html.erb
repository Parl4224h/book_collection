<% content_for :title, "User Books | Book Collection" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">Reading assignments</p>
    <h1>User Books</h1>
  </div>
  <%= link_to "New User Book", new_user_book_path, class: "button button-primary" %>
</div>

<div class="form-actions">
  <%= link_to "Book Index", books_path, class: "button button-secondary" %>
  <%= link_to "User Index", users_path, class: "button button-secondary" %>
</div>

<% @user_books.each do |user_book| %>
  <section class="book-row">
    <p><strong>User:</strong> <%= user_book.user.username %></p>
    <p><strong>Book:</strong> <%= user_book.book.title %></p>
    <div class="book-actions">
      <%= link_to "Show", user_book, class: "button button-secondary" %>
      <%= link_to "Update", edit_user_book_path(user_book), class: "button button-secondary" %>
      <%= button_to "Delete", user_book, method: :delete, class: "button button-danger" %>
    </div>
  </section>
<% end %>

<% if @user_books.empty? %>
  <p class="empty-state">No books have been assigned yet.</p>
<% end %>
